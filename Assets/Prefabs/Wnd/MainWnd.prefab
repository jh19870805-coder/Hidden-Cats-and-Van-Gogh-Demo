  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "My dear friend,\r\n\r\nI\u2019m sorry I couldn\u2019t wait for you\u2014I
    had to head into town to attend to something important. The door is unlocked,
    so please feel free to come in and make yourself at home, just as if you were
    returning to your own place.\r\n\r\nThere are plenty of little mischief-makers
    here. If you feel a bit lonely, you\u2019re welcome to pass the time with them.\r\n\r\nBy
    the way, the unfinished puzzle on the chair by the window seems to have lost
    a few pieces\u2014probably because of them. If you\u2019d like, please keep an
    eye out for them."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
